{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=DevMatchDb;Username=postgres;Password=postgres"
  },

  "GitHub": {
    "BaseUrl": "https://api.github.com",
    "ApiBaseUrl": "https://api.github.com",
    "AuthorizationUrl": "https://github.com/login/oauth/authorize",
    "AccessTokenUrl": "https://github.com/login/oauth/access_token",
    "CallbackUrl": "https://localhost:7226/api/auth/github/callback",
    "Scope": "read:user user:email",
    "ClientId": "",
    "ClientSecret": "",
    "UserAgent": "DevMatch",
    "TimeoutSeconds": 30,
    "ApiVersion": "2022-11-28",
    "PageSize": 100
  },
  "Authentication": {
    "Jwt": {
      "Issuer": "DevMatch",
      "Audience": "DevMatch.Api",
      "SigningKey": "",
      "ExpirationMinutes": 60
    },
    "OAuthState": {
      "SigningKey": "",
      "LifetimeMinutes": 10
    },
    "GitHubTokenEncryption": {
      "Key": ""
    }
  }
}